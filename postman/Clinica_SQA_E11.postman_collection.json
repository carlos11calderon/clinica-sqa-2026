        {
          "name": "01 - Health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function formatDate(d) { return d.toISOString().slice(0, 10); }",
                  "function nextWeekday(startOffset) {",
                  "  const d = new Date();",
                  "  d.setHours(12, 0, 0, 0);",
                  "  d.setDate(d.getDate() + startOffset);",
                  "  while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);",
                  "  return d;",
                  "}",
                  "const first = nextWeekday(7);",
                  "const second = new Date(first);",
                  "second.setDate(second.getDate() + 1);",
                  "while (second.getDay() === 0 || second.getDay() === 6) second.setDate(second.getDate() + 1);",
                  "pm.collectionVariables.set('appointmentDate', formatDate(first));",
                  "pm.collectionVariables.set('rescheduleDate', formatDate(second));",
                  "pm.collectionVariables.set('appointmentTime', '09:00');",
                  "pm.collectionVariables.set('rescheduleTime', '10:30');",
                  "pm.collectionVariables.set('patientId', '');",
                  "pm.collectionVariables.set('doctorId', '');",
                  "pm.collectionVariables.set('appointmentId', '');",
                  "pm.collectionVariables.set('consultationId', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Contenido: servicio UP', () => pm.expect(json.data.status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
